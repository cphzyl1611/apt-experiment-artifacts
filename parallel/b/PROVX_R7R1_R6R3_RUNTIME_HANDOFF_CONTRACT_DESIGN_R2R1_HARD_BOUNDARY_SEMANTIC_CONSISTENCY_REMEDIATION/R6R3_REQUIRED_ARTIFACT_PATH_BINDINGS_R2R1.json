{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provx://r7r1/r6r3/authenticated-runtime-handoff/r2r1/artifact-path-bindings",
  "title": "R6R3 Required Artifact Path Bindings R2R1",
  "contract_version": "2.1.0",
  "purpose": "The complete, exact, runtime-root-bound inventory of the twenty artifacts required for authenticated handoff.",
  "runtime_root_policy": {
    "selection": "MANIFEST_FIRST_EXACT_PATH_ONLY",
    "runtime_root_source": "handoff.run_identity.runtime_root",
    "binding_root_source": "selected_inputs.runtime_root",
    "required_equality": "selected_inputs.runtime_root == handoff.run_identity.runtime_root == package_manifest.runtime_root",
    "directory_discovery": "REJECT",
    "basename_fallback": "REJECT",
    "glob_or_pattern": "REJECT",
    "latest_run_selection": "REJECT",
    "cross_run_substitution": "REJECT",
    "cross_root_substitution": "REJECT",
    "symlink_or_alias_substitution": "REJECT",
    "dot_segment": "REJECT",
    "race_or_object_replacement": "REJECT"
  },
  "required_artifact_ids": [
    "r6_privileged_result",
    "r6_audit_pre_state",
    "r6_lineage",
    "r6_static_audit",
    "r6_pre_run_contract",
    "r6_transient_rule_contract",
    "r6_rule_remediation_journal",
    "r6_residual_remediation",
    "r6_raw_audit",
    "r6_normalized_events",
    "r6_pid_netns_join",
    "r6_strace_oracle_comparison",
    "r6_coverage_and_loss",
    "r6_post_cleanup",
    "r6_child_state_transitions",
    "r6_child_process_evidence",
    "r6_early_child_failures",
    "r6_audit_smoke_report",
    "r6_pcap",
    "r6_privileged_execution_receipt"
  ],
  "artifact_roles": {
    "r6_privileged_result": "execution_result",
    "r6_audit_pre_state": "audit_baseline_state",
    "r6_lineage": "runtime_collection_provenance",
    "r6_static_audit": "producer_static_audit",
    "r6_pre_run_contract": "pre_run_contract",
    "r6_transient_rule_contract": "transient_rule_contract",
    "r6_rule_remediation_journal": "rule_remediation_journal",
    "r6_residual_remediation": "residual_remediation_evidence",
    "r6_raw_audit": "raw_audit_evidence",
    "r6_normalized_events": "normalized_audit_events",
    "r6_pid_netns_join": "pid_start_netns_join",
    "r6_strace_oracle_comparison": "strace_oracle_comparison",
    "r6_coverage_and_loss": "coverage_and_loss_summary",
    "r6_post_cleanup": "post_cleanup_revalidation",
    "r6_child_state_transitions": "child_state_transitions",
    "r6_child_process_evidence": "child_process_evidence",
    "r6_early_child_failures": "early_child_failures",
    "r6_audit_smoke_report": "audit_smoke_report",
    "r6_pcap": "network_capture_evidence",
    "r6_privileged_execution_receipt": "privileged_execution_receipt"
  },
  "parsed_artifact_schemas": {
    "r6_privileged_result": "R6R3_RUNTIME_ARTIFACT_CONTENT_SCHEMAS_R2R1.json#/$defs/privilegedResult",
    "r6_audit_pre_state": "R6R3_RUNTIME_ARTIFACT_CONTENT_SCHEMAS_R2R1.json#/$defs/auditPreState",
    "r6_lineage": "R6R3_RUNTIME_ARTIFACT_CONTENT_SCHEMAS_R2R1.json#/$defs/collectionProvenance",
    "r6_static_audit": "R6R3_RUNTIME_ARTIFACT_CONTENT_SCHEMAS_R2R1.json#/$defs/staticAudit",
    "r6_pre_run_contract": "R6R3_RUNTIME_ARTIFACT_CONTENT_SCHEMAS_R2R1.json#/$defs/preRunContract",
    "r6_transient_rule_contract": "R6R3_RUNTIME_ARTIFACT_CONTENT_SCHEMAS_R2R1.json#/$defs/transientRuleContract",
    "r6_rule_remediation_journal": "R6R3_RUNTIME_ARTIFACT_CONTENT_SCHEMAS_R2R1.json#/$defs/ruleRemediationJournal",
    "r6_residual_remediation": "R6R3_RUNTIME_ARTIFACT_CONTENT_SCHEMAS_R2R1.json#/$defs/residualRemediation",
    "r6_raw_audit": "R6R3_RUNTIME_ARTIFACT_CONTENT_SCHEMAS_R2R1.json#/$defs/rawAuditRecord",
    "r6_normalized_events": "R6R3_RUNTIME_ARTIFACT_CONTENT_SCHEMAS_R2R1.json#/$defs/normalizedEventRecord",
    "r6_pid_netns_join": "R6R3_RUNTIME_ARTIFACT_CONTENT_SCHEMAS_R2R1.json#/$defs/pidNetnsJoinRecord",
    "r6_strace_oracle_comparison": "R6R3_RUNTIME_ARTIFACT_CONTENT_SCHEMAS_R2R1.json#/$defs/straceOracleComparison",
    "r6_coverage_and_loss": "R6R3_RUNTIME_ARTIFACT_CONTENT_SCHEMAS_R2R1.json#/$defs/coverageAndLoss",
    "r6_post_cleanup": "R6R3_RUNTIME_ARTIFACT_CONTENT_SCHEMAS_R2R1.json#/$defs/postCleanup",
    "r6_child_state_transitions": "R6R3_RUNTIME_ARTIFACT_CONTENT_SCHEMAS_R2R1.json#/$defs/childStateTransition",
    "r6_child_process_evidence": "R6R3_RUNTIME_ARTIFACT_CONTENT_SCHEMAS_R2R1.json#/$defs/childProcessEvidence",
    "r6_early_child_failures": "R6R3_RUNTIME_ARTIFACT_CONTENT_SCHEMAS_R2R1.json#/$defs/earlyChildFailure",
    "r6_audit_smoke_report": "R6R3_RUNTIME_ARTIFACT_CONTENT_SCHEMAS_R2R1.json#/$defs/auditSmokeReport",
    "r6_pcap": "R6R3_RUNTIME_ARTIFACT_CONTENT_SCHEMAS_R2R1.json#/$defs/pcapExactBytes",
    "r6_privileged_execution_receipt": "R6R3_PRIVILEGED_EXECUTION_RECEIPT_SCHEMA_R2R1.json"
  },
  "binding_map_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "r6_privileged_result",
      "r6_audit_pre_state",
      "r6_lineage",
      "r6_static_audit",
      "r6_pre_run_contract",
      "r6_transient_rule_contract",
      "r6_rule_remediation_journal",
      "r6_residual_remediation",
      "r6_raw_audit",
      "r6_normalized_events",
      "r6_pid_netns_join",
      "r6_strace_oracle_comparison",
      "r6_coverage_and_loss",
      "r6_post_cleanup",
      "r6_child_state_transitions",
      "r6_child_process_evidence",
      "r6_early_child_failures",
      "r6_audit_smoke_report",
      "r6_pcap",
      "r6_privileged_execution_receipt"
    ],
    "properties": {
      "r6_privileged_result": {"$ref": "#/$defs/binding"},
      "r6_audit_pre_state": {"$ref": "#/$defs/binding"},
      "r6_lineage": {"$ref": "#/$defs/binding"},
      "r6_static_audit": {"$ref": "#/$defs/binding"},
      "r6_pre_run_contract": {"$ref": "#/$defs/binding"},
      "r6_transient_rule_contract": {"$ref": "#/$defs/binding"},
      "r6_rule_remediation_journal": {"$ref": "#/$defs/binding"},
      "r6_residual_remediation": {"$ref": "#/$defs/binding"},
      "r6_raw_audit": {"$ref": "#/$defs/binding"},
      "r6_normalized_events": {"$ref": "#/$defs/binding"},
      "r6_pid_netns_join": {"$ref": "#/$defs/binding"},
      "r6_strace_oracle_comparison": {"$ref": "#/$defs/binding"},
      "r6_coverage_and_loss": {"$ref": "#/$defs/binding"},
      "r6_post_cleanup": {"$ref": "#/$defs/binding"},
      "r6_child_state_transitions": {"$ref": "#/$defs/binding"},
      "r6_child_process_evidence": {"$ref": "#/$defs/binding"},
      "r6_early_child_failures": {"$ref": "#/$defs/binding"},
      "r6_audit_smoke_report": {"$ref": "#/$defs/binding"},
      "r6_pcap": {"$ref": "#/$defs/binding"},
      "r6_privileged_execution_receipt": {"$ref": "#/$defs/binding"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolutePath": {"type": "string", "pattern": "^/[^\\u0000]*$", "minLength": 2},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "role", "content_schema", "path", "path_form", "runtime_root", "sha256", "byte_length", "object_identity", "status"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "content_schema": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/absolutePath"},
        "path_form": {"const": "ABSOLUTE_CANONICAL_NO_DOT_NO_SYMLINK"},
        "runtime_root": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 0},
        "object_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["device", "inode", "mode_type", "lstat_matches_open_fstat"],
          "properties": {
            "device": {"type": "integer", "minimum": 0},
            "inode": {"type": "integer", "minimum": 1},
            "mode_type": {"const": "REGULAR_FILE"},
            "lstat_matches_open_fstat": {"const": true}
          }
        },
        "status": {"const": "BOUND_AND_HASHED"}
      }
    }
  }
}
