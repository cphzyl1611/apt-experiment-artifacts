{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provx://r7r1/r6r3/authenticated-runtime-handoff/r2/privileged-execution-receipt",
  "title": "R6R3 Privileged Execution Receipt R2",
  "description": "Dedicated receipt schema. It is not a generic artifact reference and cannot be satisfied by a claimed privileged_execution object alone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_version", "receipt_status", "manifest_binding", "runtime_binding", "producer_identity", "authorization", "invocation_count", "invocation", "receipt_hash"],
  "properties": {
    "schema": {"const": "R6R3_PRIVILEGED_EXECUTION_RECEIPT_R2"},
    "receipt_version": {"const": "2.0.0"},
    "receipt_status": {"const": "AUTHENTICATED_EXECUTION_RECEIPT"},
    "manifest_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "manifest_sha256", "binding_kind"],
      "properties": {
        "artifact_id": {"const": "r6_privileged_execution_receipt"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "binding_kind": {"const": "PACKAGE_MANIFEST_SHA256_EXACT"}
      }
    },
    "runtime_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "runtime_root", "binding_kind"],
      "properties": {
        "run_id": {"$ref": "#/$defs/id"},
        "runtime_root": {"$ref": "#/$defs/absolutePath"},
        "binding_kind": {"const": "RUN_ID_AND_EXACT_RUNTIME_ROOT"}
      }
    },
    "producer_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer_id", "program_path", "producer_source_sha256", "identity_kind"],
      "properties": {
        "producer_id": {"$ref": "#/$defs/id"},
        "program_path": {"$ref": "#/$defs/absolutePath"},
        "producer_source_sha256": {"$ref": "#/$defs/sha256"},
        "identity_kind": {"const": "EXACT_PROGRAM_PATH_AND_SOURCE_HASH"}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_initiated", "authorization_reference"],
      "properties": {
        "human_initiated": {"const": true},
        "authorization_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference_type", "reference_value"],
          "properties": {
            "reference_type": {"enum": ["TICKET", "RUN_APPROVAL", "OPERATOR_ASSERTION", "OTHER_REVIEWED_REFERENCE"]},
            "reference_value": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "invocation_count": {"const": 1},
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocation_id", "exact_command", "command_argv", "program_path", "uid", "euid", "start_time_utc", "end_time_utc", "pid", "pid_start_time_ticks", "netns_inode", "exit_code", "result_status", "classification", "micro_probe_verdict", "micro_probe_cleanup_state", "mininet_executed"],
      "properties": {
        "invocation_id": {"$ref": "#/$defs/id"},
        "exact_command": {"type": "string", "minLength": 1},
        "command_argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "program_path": {"$ref": "#/$defs/absolutePath"},
        "uid": {"const": 0},
        "euid": {"const": 0},
        "start_time_utc": {"$ref": "#/$defs/dateTime"},
        "end_time_utc": {"$ref": "#/$defs/dateTime"},
        "pid": {"type": "integer", "minimum": 1},
        "pid_start_time_ticks": {"type": "integer", "minimum": 1},
        "netns_inode": {"type": "integer", "minimum": 1},
        "exit_code": {"const": 0},
        "result_status": {"const": "COMPLETED"},
        "classification": {"const": "PASS_READY_FOR_GRAPH_NORMALIZATION"},
        "micro_probe_verdict": {"const": "PASS"},
        "micro_probe_cleanup_state": {"const": "RULE_REMOVED_BASELINE_RESTORED"},
        "mininet_executed": {"const": true}
      }
    },
    "receipt_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolutePath": {"type": "string", "pattern": "^/[^\\u0000]*$", "minLength": 2},
    "dateTime": {"type": "string", "format": "date-time"}
  }
}
