    {
      "rule_id": "H017_FINAL_CANONICAL_RECHECK",
      "severity": "BLOCK",
      "assertions": [
        {"subject": "handoff", "operator": "serializes_to_same_canonical_bytes", "value": true},
        {"subject": "manifest.entries[]", "operator": "revalidated_after_all_reads", "value": true},
        {"subject": "all_rule_failures", "operator": "empty", "value": true}
      ],
      "failure_code": "FINAL_CANONICAL_OR_CONSISTENCY_RECHECK_FAILED"
    }
  ],
  "failure_policy": {
    "duplicate": "BLOCK",
    "missing": "BLOCK",
    "inconsistent": "BLOCK",
    "malformed": "BLOCK",
    "unverifiable": "BLOCK",
    "noncanonical": "BLOCK",
    "partial_class_coverage": "BLOCK",
    "runtime_data_fabrication": "BLOCK",
    "no_best_effort": true,
    "no_inference_from_pcap": true,
