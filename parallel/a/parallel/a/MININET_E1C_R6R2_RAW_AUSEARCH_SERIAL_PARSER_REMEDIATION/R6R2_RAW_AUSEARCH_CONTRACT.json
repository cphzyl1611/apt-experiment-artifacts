{
  "schema": "MININET_E1C_R6R2_RAW_AUSEARCH_CONTRACT_V1",
  "polling": {
    "query": ["/usr/sbin/ausearch", "-k", "<exact_random_key>", "--raw"],
    "evidence_mode": "RAW",
    "interpreted_mode_allowed": false,
    "bounded_monotonic_poll_preserved": true,
    "max_visibility_wait_seconds": 2.0,
    "max_poll_interval_seconds": 0.1
  },
  "serial_parser": {
    "accepted_syntax": "msg=audit(<epoch-or-raw-timestamp>:<integer-serial>)",
    "interpreted_locale_timestamp_accepted": false,
    "integer_serial_required": true
  },
  "pass_gate": [
    "parseable raw audit serial",
    "exact audit key present",
    "exact watched path present",
    "micro_probe_verdict() == PASS"
  ],
  "timeout_verdict": "BLOCKED",
  "timeout_state": "AUDIT_EVIDENCE_MISSING",
  "diagnostics": [
    "poll_attempts",
    "elapsed_visibility_latency",
    "final_ausearch_returncode",
    "key_seen",
    "path_seen",
    "audit_serial",
    "evidence_mode"
  ],
  "r6r1_semantics_preserved": {
    "exact_rule_path_perm_pid_key": true,
    "exact_inverse_rule_removal": true,
    "temporary_probe_file_deletion": true,
    "clean_baseline_reverification": true,
    "downstream_real_mininet_smoke_unchanged": true,
    "auditd_configuration_changed": false
  }
}
