{
  "schema": "MININET_E1C_R6R1_BOUNDED_POLL_CONTRACT_V1",
  "implementation": {
    "helper": "poll_audit_evidence",
    "command": ["/usr/sbin/ausearch", "-k", "<random_key>", "-i"],
    "exact_key_only": true,
    "exact_watched_path_required": true,
    "parseable_audit_serial_required": true,
    "micro_probe_verdict_required": "PASS",
    "max_visibility_wait_seconds": 2.0,
    "max_poll_interval_seconds": 0.1,
    "clock": "monotonic",
    "timeout_verdict": "BLOCKED",
    "timeout_state": "AUDIT_EVIDENCE_MISSING"
  },
  "diagnostics": [
    "poll_attempts",
    "elapsed_visibility_latency",
    "final_ausearch_returncode",
    "key_seen",
    "path_seen"
  ],
  "cleanup_contract": {
    "exact_inverse_rule_removal": true,
    "temporary_probe_file_deleted": true,
    "clean_audit_baseline_reverified": true,
    "cleanup_on_timeout_exception_and_success": true
  },
  "downstream_smoke_semantics_changed": false
}
