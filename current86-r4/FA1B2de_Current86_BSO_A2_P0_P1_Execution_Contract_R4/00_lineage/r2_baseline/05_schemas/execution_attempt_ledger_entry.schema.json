{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "attempt_sequence": {
      "type": "integer"
    },
    "entry_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "const": null
        }
      ]
    },
    "error_class": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "const": null
        }
      ]
    },
    "raw_key": {
      "pattern": "^[0-9]+::S[0-9]{2}::A[0-9]{3}$",
      "type": "string"
    },
    "schema": {
      "minLength": 1,
      "type": "string"
    },
    "stage": {
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema",
    "raw_key",
    "attempt_id",
    "attempt_sequence",
    "stage",
    "status",
    "error_class",
    "entry_id"
  ],
  "schema_id": "9b1db78a7afb3be5bfcbe83264663089c4cfea44b55a530f780ccd94226a309c",
  "title": "Execution attempt ledger entry",
  "type": "object"
}
