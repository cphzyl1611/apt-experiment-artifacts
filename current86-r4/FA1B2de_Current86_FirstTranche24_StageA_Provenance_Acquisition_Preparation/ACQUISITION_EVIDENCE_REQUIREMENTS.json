        "object_extraction_rule_id",
        "object_extraction_rule_sha256",
        "source_object_locator",
        "source_object_locator_sha256",
        "object_match_cardinality",
        "source_object_sha256",
        "exact_recomputation_receipt"
      ],
      "creates_now": false
    },
    {
      "step": 4,
      "name": "canonical_field_resolution",
      "required_evidence": [
        "canonical_source_schema_namespace",
        "canonical_source_schema_identity_version_hash",
        "canonical_intrinsic_field_semantics_id",
        "exact_rfc6901_pointer",
        "field_type",
        "canonicalization_profile_id",
        "authenticated_canonical_value_sha256",
        "canonical_field_identity"
      ],
      "creates_now": false
    },
    {
      "step": 5,
      "name": "mapping_evidence_preparation",
      "required_evidence": [
        "mapping_record_id",
        "mapping_record_identity",
        "complete_provenance_chain",
        "full_evidence_record_sha256",
        "conflict_recomputation_sha256"
      ],
      "creates_now": false,
      "downstream_gate": "must precede separate Stage A admission record"
    },
    {
      "step": 6,
      "name": "independent_stage_a_admission",
      "required_evidence": [
        "mapping_evidence_record_sha256",
        "mapping_record_id_recomputed",
        "provenance_chain_complete",
        "active_lineage_verified",
        "decision_status",
        "independent_reviewer_identity"
      ],
      "creates_now": false,
      "downstream_gate": "only ADMISSION_READY can enable Stage B"
    }
  ],
  "shared_mechanical_controls": [
    "exact 24-target order and identity verification",
    "source-manifest presence and exact-reference checks",
    "artifact/object/value SHA-256 recomputation",
    "exact-one locator cardinality check",
    "RFC6901 resolution and field-type check",
