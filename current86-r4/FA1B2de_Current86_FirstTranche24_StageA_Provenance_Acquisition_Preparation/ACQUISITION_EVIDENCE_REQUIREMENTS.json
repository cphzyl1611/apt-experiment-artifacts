      "required_evidence": [
        "source_artifact_identity",
        "source_artifact_sha256",
        "source_version_identity",
        "source_owner_or_issuer_identity",
        "acquisition_authentication",
        "verifier_identity",
        "signed_release_or_pinned_commit_tree_proof"
      ],
      "creates_now": false
    },
    {
      "step": 3,
      "name": "object_extraction",
