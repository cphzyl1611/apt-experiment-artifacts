    "failure_reason": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/failureReason"}]},
    "downstream_eligibility": {"const": "NOT_ELIGIBLE"},
    "operational_boundary": {"$ref": "#/$defs/operationalBoundary"}
  },
  "allOf": [
    {
      "if": {"properties": {"record_mode": {"const": "DESIGN_ONLY_TEMPLATE"}}},
      "then": {
        "properties": {
          "acquisition_status": {"const": "DESIGN_ONLY"},
          "acquisition_channel": {"const": null},
          "acquisition_provenance": {"const": null},
          "retrieved_artifact_reference": {"const": null},
          "immutable_version_representation": {"const": null},
          "content_digest": {"const": null},
          "descriptor_to_artifact_lineage_evidence": {"const": null},
          "owner_issuer_authorization_evidence": {"const": null},
          "failure_reason": {"const": null},
          "operational_boundary": {"properties": {"source_acquisition": {"const": "NO"}}}
        }
      }
    },
    {
      "if": {"properties": {"record_mode": {"const": "FUTURE_ACQUISITION_TRANSACTION"}}},
      "then": {
        "required": ["transaction_identity", "acquisition_channel", "acquisition_provenance"],
        "properties": {
          "transaction_identity": {"$ref": "#/$defs/futureTransactionIdentity"},
          "acquisition_channel": {"$ref": "#/$defs/acquisitionChannel"},
          "acquisition_provenance": {"$ref": "#/$defs/acquisitionProvenance"}
        }
      }
    },
    {
      "if": {"properties": {"requested_artifact_identity": {"properties": {"resolution_status": {"const": "PENDING_EXACT_RESOLUTION"}}}}},
      "then": {"properties": {"requested_artifact_identity": {"properties": {"resolved_artifact": {"const": null}}}}}
    },
    {
      "if": {"properties": {"requested_artifact_identity": {"properties": {"resolution_status": {"const": "UNIQUE_EXACT_RESOLUTION"}}}}},
      "then": {"properties": {"requested_artifact_identity": {"properties": {"resolved_artifact": {"type": "object"}}}}}
    },
    {
      "if": {"properties": {"acquisition_status": {"const": "REJECTED"}}},
      "then": {"required": ["failure_reason"], "properties": {"failure_reason": {"$ref": "#/$defs/failureReason"}}}
    },
    {
      "if": {"properties": {"acquisition_status": {"enum": ["EVIDENCE_ENVELOPE_ASSEMBLED", "PENDING_AUTHENTICATION"]}}},
      "then": {
        "required": ["retrieved_artifact_reference", "immutable_version_representation", "content_digest", "descriptor_to_artifact_lineage_evidence", "owner_issuer_authorization_evidence"],
        "properties": {
          "retrieved_artifact_reference": {"$ref": "#/$defs/retrievedArtifact"},
          "immutable_version_representation": {"$ref": "#/$defs/immutableVersion"},
