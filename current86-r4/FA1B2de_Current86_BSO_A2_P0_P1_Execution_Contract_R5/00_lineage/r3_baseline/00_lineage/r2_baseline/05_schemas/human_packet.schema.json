{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authenticated_raw_action_reference": {
      "minLength": 1,
      "type": "string"
    },
    "candidate_count": {
      "minimum": 0,
      "type": "integer"
    },
    "candidate_side_evidence_fact_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "array"
    },
    "candidate_side_evidence_source_references": {
      "items": {
        "minProperties": 1,
        "type": "object"
      },
      "type": "array"
    },
    "comparison_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "comparison_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "complete_candidate_count": {
      "minimum": 0,
      "type": "integer"
    },
    "complete_candidate_universe_disclosed": {
      "const": true
    },
    "complete_candidate_universe_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "complete_universe_expansion_audit": {
      "additionalProperties": false,
      "properties": {
        "complete_candidate_count_exact_match": {
          "const": true
        },
        "expanded_option_count": {
          "minimum": 0,
          "type": "integer"
        },
        "option_mapping_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "option_mapping_hash",
        "expanded_option_count",
        "complete_candidate_count_exact_match"
      ],
      "type": "object"
    },
    "concise_source_grounded_basis": {
      "minLength": 1,
      "type": "string"
    },
    "full_candidate_option_mapping": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "candidate_label_or_reference": {
            "minLength": 1,
            "type": "string"
          },
          "candidate_scoring_id": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "packet_local_human_option_id": {
            "minLength": 1,
            "type": "string"
          },
          "relation_identity": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "packet_local_human_option_id",
          "candidate_scoring_id",
          "relation_identity",
          "candidate_label_or_reference"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "hidden_pruning": {
      "const": "NO"
    },
    "human_input_mode": {
      "const": "PACKET_LOCAL_OPTION_ONLY_NO_MANUAL_ID_OR_HASH_ENTRY"
    },
    "human_packet_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "const": null
        }
      ]
    },
    "machine_proposal_label": {
      "const": "NON_AUTHORITATIVE_MACHINE_PROPOSAL"
    },
    "normative_actions": {
      "const": [
        "CONFIRM_PROPOSED_OWNER",
        "REJECT_PROPOSAL_AND_SELECT_OTHER_EXISTING_CANDIDATE",
        "NOT_SURE_ESCALATE"
      ]
    },
    "primary_commitment_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "primary_commitment_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "proposal_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "proposed_candidate_scoring_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "proposed_relation_identity": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "raw_action": {
      "minLength": 1,
      "type": "string"
    },
    "raw_key": {
      "pattern": "^[0-9]+::S[0-9]{2}::A[0-9]{3}$",
      "type": "string"
    },
    "raw_side_evidence_fact_ids": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "array"
    },
    "raw_side_evidence_source_references": {
      "items": {
        "minProperties": 1,
        "type": "object"
      },
      "type": "array"
    },
    "schema": {
      "minLength": 1,
      "type": "string"
    },
    "top_k_truncation": {
      "const": "NO"
    },
    "verifier_commitment_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "verifier_commitment_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "verifier_comparison_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "raw_key",
    "raw_action",
    "authenticated_raw_action_reference",
    "machine_proposal_label",
    "proposed_candidate_scoring_id",
    "proposed_relation_identity",
    "primary_commitment_id",
    "primary_commitment_hash",
    "verifier_commitment_id",
    "verifier_commitment_hash",
    "comparison_id",
    "comparison_hash",
    "raw_side_evidence_fact_ids",
    "candidate_side_evidence_fact_ids",
    "raw_side_evidence_source_references",
    "candidate_side_evidence_source_references",
    "concise_source_grounded_basis",
    "complete_candidate_universe_hash",
    "complete_candidate_count",
    "full_candidate_option_mapping",
    "complete_universe_expansion_audit",
    "human_input_mode",
    "candidate_count",
    "complete_candidate_universe_disclosed",
    "hidden_pruning",
    "top_k_truncation",
    "normative_actions",
    "proposal_hash",
    "verifier_comparison_hash",
    "human_packet_id"
  ],
  "schema_id": "dc980e557dae84afdd798fd5f3c3b24df4714f6948e5b52653aabbcf0491542e",
  "title": "Immutable A2 human packet R2",
  "type": "object"
}
