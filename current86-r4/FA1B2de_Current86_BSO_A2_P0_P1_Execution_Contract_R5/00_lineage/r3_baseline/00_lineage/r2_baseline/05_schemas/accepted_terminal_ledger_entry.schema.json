    },
    "terminal_record_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "raw_key",
    "accepted_terminal_id",
    "terminal_record_hash",
    "independent_review_id",
    "entry_id"
  ],
  "schema_id": "e9f125d1a231b51f9e8c1c4f792371bb227e68178d68d1e0b66a8486c86fcbd1",
